[global]
    monitor = 0
    follow = mouse
    geometry = "300x50-15+50"
    shrink = yes
    transparency = 10
    notification_limit = 5
    offset = "10x10"
    align = left
    vertical_alignment = center
    sticky_history = yes
    history_length = 20
    show_indicators = yes
    separator_height = 2
    padding = 12
    horizontal_padding = 12
    text_icon_padding = 8
    frame_width = 2
    frame_color = "#33ccff"
    separator_color = auto
    sort = yes
    indicate_hidden = yes
    idle_threshold = 120
    font = "Noto Sans 10"
    line_height = 4
    markup = full
    format = "<b>%s</b>\\n%b"
    ellipsize = middle
    ignore_newline = false
    stack_duplicates = true
    hide_duplicate_count = false
    show_age_threshold = 60
    word_wrap = yes
    ignore_dbusclose = false
    force_xwayland = false
    corner_radius = 6
    mouse_left_click = close_current
    mouse_middle_click = close_all
    mouse_right_click = context

[urgency_low]
    background = "#2e2e2e"
    foreground = "#aaaaaa"
    timeout = 5
    highlight = "#33ccff"

[urgency_normal]
    background = "#2e2e2e"
    foreground = "#ffffff"
    timeout = 8
    highlight = "#33ccff"

[urgency_critical]
    background = "#441111"
    foreground = "#ffffff"
    timeout = 0
    highlight = "#ff4444"
